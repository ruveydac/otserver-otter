FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends samba \
    && rm -rf /var/lib/apt/lists/*
COPY devices/smb.conf /etc/samba/smb.conf
ENTRYPOINT ["sh", "-c", "nmbd --daemon && /usr/libexec/samba/samba-dcerpcd --daemon --libexec-rpcds && exec smbd --foreground --no-process-group --debug-stdout"]
