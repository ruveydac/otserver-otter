{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otserver.org/contracts/otserver-scan-v2.schema.json",
  "title": "OTserver Scan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "scanner",
    "scan",
    "devices",
    "links",
    "unresolved",
    "warnings",
    "errors"
  ],
  "properties": {
    "format": { "const": "otserver-scan" },
    "schemaVersion": { "const": 2 },
    "scanner": { "$ref": "#/$defs/scanner" },
    "scan": { "$ref": "#/$defs/scan" },
    "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "unresolved": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "npcapVersion": { "type": "string" }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startedAt", "finishedAt", "targets", "interface"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "interface": { "$ref": "#/$defs/interfaceRef" },
        "partial": { "type": "boolean" }
      }
    },
    "interfaceRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "macAddress": { "$ref": "#/$defs/mac" },
        "addresses": { "type": "array", "items": { "type": "string" } },
        "ipRoutePolicy": { "const": "operating-system" }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macAddress",
        "macAddresses",
        "ipAddresses",
        "observations",
        "interfaces",
        "ports"
      ],
      "properties": {
        "macAddress": { "$ref": "#/$defs/mac" },
        "macAddresses": { "type": "array", "items": { "$ref": "#/$defs/mac" } },
        "ipAddresses": { "type": "array", "items": { "type": "string" } },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/observation" }
        },
        "interfaces": { "type": "array", "items": { "$ref": "#/$defs/networkInterface" } },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observedAt", "fields", "raw", "warnings"],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "arp",
            "bacnet",
            "dnp3",
            "ethernet-ip",
            "iec61850",
            "lldp",
            "netbios",
            "niagara-fox",
            "omron-fins",
            "opc-ua",
            "os-fingerprint",
            "profinet-dcp",
            "s7",
            "snmp",
            "unknown"
          ]
        },
        "observedAt": { "type": "string", "format": "date-time" },
        "ipAddress": { "type": "string" },
        "macAddress": { "$ref": "#/$defs/mac" },
        "fields": {
          "description": "Normalized inventory fields and protocol metadata. PROFINET DCP retains numeric vendorId/deviceId and includes vendor resolved from the bundled manufacturer table when known; unknown vendor IDs omit vendor.",
          "type": "object",
          "additionalProperties": true
        },
        "raw": { "$ref": "#/$defs/rawEvidence" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "networkInterface": {
      "type": "object",
      "additionalProperties": true,
      "required": ["key", "source"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "macAddress": { "$ref": "#/$defs/mac" },
        "ipAddresses": { "type": "array", "items": { "type": "string" } },
        "adminStatus": { "type": "string" },
        "operStatus": { "type": "string" },
        "speed": { "type": "integer", "minimum": 0 },
        "mtu": { "type": "integer", "minimum": 0 },
        "raw": {}
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": true,
      "required": ["key", "source"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "interfaceKey": { "type": "string" },
        "portId": { "type": "string" },
        "description": { "type": "string" },
        "macAddress": { "$ref": "#/$defs/mac" },
        "vlans": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 4095 } },
        "raw": {}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["macAddress"],
      "properties": {
        "macAddress": { "$ref": "#/$defs/mac" },
        "stationName": { "type": "string" },
        "interfaceKey": { "type": "string" },
        "portId": { "type": "string" },
        "portMac": { "$ref": "#/$defs/mac" }
      }
    },
    "rawEvidence": {
      "description": "Known identity evidence is validated; protocol-specific evidence remains opaque.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "observationId": { "type": "string", "format": "uuid" },
            "subject": { "$ref": "#/$defs/subject" },
            "serialClaim": {
              "oneOf": [{ "$ref": "#/$defs/serialClaim" }, { "type": "null" }]
            },
            "identityComponentRef": { "type": "string", "minLength": 1 },
            "physicalEntities": {
              "type": "array",
              "items": { "$ref": "#/$defs/physicalEntity" }
            },
            "pnioRecords": { "type": "array", "items": { "$ref": "#/$defs/pnioRecord" } }
          }
        },
        { "type": ["array", "string", "number", "boolean", "null"] }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["device", "endpoint", "opc-ua-asset", "logical-node"]
        },
        "macAddress": { "$ref": "#/$defs/mac" },
        "ipAddress": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "logicalDevice": { "type": "string", "minLength": 1 },
        "logicalNode": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "device" } }, "required": ["kind"] },
          "then": { "required": ["macAddress"] }
        },
        {
          "if": { "properties": { "kind": { "const": "endpoint" } }, "required": ["kind"] },
          "then": { "required": ["ipAddress"] }
        },
        {
          "if": { "properties": { "kind": { "const": "opc-ua-asset" } }, "required": ["kind"] },
          "then": { "required": ["nodeId"] }
        },
        {
          "if": { "properties": { "kind": { "const": "logical-node" } }, "required": ["kind"] },
          "then": { "required": ["logicalDevice", "logicalNode"] }
        }
      ]
    },
    "serialClaim": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scope", "original", "encoding", "normalizationVersion"],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "device",
            "adapter",
            "cpu",
            "module",
            "chassis",
            "stack",
            "submodule",
            "asset",
            "physical-device",
            "backplane",
            "container",
            "power-supply",
            "fan",
            "sensor",
            "port",
            "unknown"
          ]
        },
        "componentRef": { "type": "string", "minLength": 1 },
        "issuer": { "type": ["string", "null"] },
        "manufacturerId": { "type": ["string", "integer", "null"] },
        "original": { "type": "string", "minLength": 1 },
        "encoding": { "type": "string", "minLength": 1 },
        "normalizationVersion": { "type": "integer", "minimum": 1 },
        "catalogNumber": { "type": ["string", "null"] }
      }
    },
    "physicalEntity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "entPhysicalIndex": { "type": "string", "minLength": 1 },
        "parentRef": { "type": ["string", "null"] },
        "parentPosition": { "type": ["integer", "null"] },
        "class": {
          "type": ["string", "null"],
          "enum": [
            "chassis",
            "backplane",
            "container",
            "power-supply",
            "fan",
            "sensor",
            "module",
            "submodule",
            "port",
            "stack",
            "cpu",
            "unknown",
            null
          ]
        },
        "serialClaim": {
          "oneOf": [{ "$ref": "#/$defs/serialClaim" }, { "type": "null" }]
        }
      }
    },
    "pnioRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["api", "slot", "subslot", "index", "parsed", "raw"],
      "properties": {
        "api": { "type": "integer", "minimum": 0 },
        "slot": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "subslot": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "index": { "type": "string", "pattern": "^0x[0-9A-F]{4}$" },
        "parsed": { "type": "object", "additionalProperties": true },
        "raw": { "type": "string", "pattern": "^(?:[0-9A-F]{2})*$" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observedAt", "local", "remote", "raw"],
      "properties": {
        "source": { "type": "string", "enum": ["lldp", "profinet-dcp", "snmp", "unknown"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "local": { "$ref": "#/$defs/endpoint" },
        "remote": { "$ref": "#/$defs/endpoint" },
        "raw": {}
      }
    },
    "mac": {
      "type": "string",
      "pattern": "^(?:[0-9A-F]{2}:){5}[0-9A-F]{2}$"
    }
  }
}
